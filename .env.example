# 数据库配置
# 本地开发默认使用 SQLite；正式部署可改成 MySQL。
DATABASE_URL=sqlite:///./lingxi.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/lingxi?charset=utf8mb4

# 可选值：local / spark / deepseek
LINGXI_LLM_PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 讯飞星火配置。如果 LINGXI_LLM_PROVIDER=spark，则使用下面三项。
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=lite
SPARK_API_PASSWORD=your_spark_api_password_here

LLM_TIMEOUT_SECONDS=60
