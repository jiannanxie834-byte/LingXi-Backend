# 数据库配置
# 本地开发默认使用 SQLite；正式部署可改成 MySQL。
DATABASE_URL=sqlite:///./lingxi.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/lingxi?charset=utf8mb4

# 比赛正式主线统一使用讯飞星火。
LINGXI_LLM_PROVIDER=spark

# 讯飞星火配置
SPARK_API_URL=https://spark-api-open.xf-yun.com/x2/chat/completions
SPARK_MODEL=spark-x
SPARK_THINKING=disabled
SPARK_STREAM=true
SPARK_KEEP_ALIVE=true
SPARK_API_PASSWORD=your_spark_api_password_here

# 用于签发登录令牌，正式环境必须设置为至少 32 字节的随机字符串。
LINGXI_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
LINGXI_TOKEN_EXPIRE_SECONDS=28800

# 仅用于本地初始化演示账号；不要提交真实值，也不要在页面或文档中公开。
LINGXI_DEMO_ADMIN_PASSWORD=replace_with_local_admin_password
LINGXI_DEMO_STUDENT_PASSWORD=replace_with_local_student_password

LLM_TIMEOUT_SECONDS=60
LLM_JSON_MAX_TOKENS=3000
